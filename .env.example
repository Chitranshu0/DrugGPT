OPENROUTER_API_KEY=your_openrouter_api_key

# Local, untracked runtime directory. Place licensed PDFs in data/raw by default.
DRUGGPT_DATA_DIR=data
DRUGGPT_API_URL=http://127.0.0.1:8000
DRUGGPT_API_HOST=127.0.0.1
DRUGGPT_API_PORT=8000
DRUGGPT_UI_PORT=8501
# Browser origins allowed to call the API (comma-separated). Add your Vercel URL here.
DRUGGPT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Regex fallback: any localhost/127.0.0.1/[::1] port and any *.vercel.app origin.
DRUGGPT_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$|^https://.*\.vercel\.app$
DRUGGPT_MODEL=nvidia/nemotron-3.5-lightning:free
DRUGGPT_RELEVANCE_THRESHOLD=0.35
DRUGGPT_RETRIEVAL_K=5

# Clarifications use a fixed reviewed message by default (no LLM call).
# Set to 1 only if you explicitly want an LLM-generated follow-up question.
DRUGGPT_LLM_CLARIFY=0

# Index quality: drop front matter, very short chunks and tiny per-document caps.
DRUGGPT_MIN_CHUNK_CHARS=120
DRUGGPT_SKIP_FRONT_MATTER_PAGES=5
DRUGGPT_MAX_CHUNKS_PER_DOCUMENT=600

# LocalStore has no authentication. Never expose it publicly.
# Only set this to 1 on a trusted local network, for a demo.
DRUGGPT_ALLOW_REMOTE=0

# No TensorFlow is needed (embeddings use the PyTorch path). These are also
# set automatically by src/core/runtime.py in every entrypoint.
USE_TF=0
TRANSFORMERS_NO_TF=1
TF_CPP_MIN_LOG_LEVEL=3

LANGCHAIN_TRACING_V2=true

# --- Vector database (Pinecone document index) ---
# Pinecone embeds chunk_text with NVIDIA llama-text-embed-v2 (1024 dim, cosine).
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=medicalchatbot
PINECONE_INDEX_HOST=medicalchatbot-p5shb1b.svc.aped-4627-b74a.pinecone.io
PINECONE_NAMESPACE=medical-books

# --- Retrieval ---
# hybrid = semantic + keyword (recommended); dense = semantic only.
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=5
RETRIEVAL_FETCH_K=20
RETRIEVAL_RRF_K=60
# Cross-encoder reranking improves precision after hybrid fusion.
RETRIEVAL_RERANK=true
RERANK_MODEL=bge-reranker-v2-m3

# --- Document ingestion ---
MEDICAL_BOOKS_DIR=Medical Books
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
MIN_CHUNK_CHARS=80
UPSERT_BATCH_SIZE=90

# --- Persistence (SQLite) ---
DATA_DIR=data
SQLITE_CHECKPOINT_DB=data/checkpoints.sqlite
SQLITE_APP_DB=data/app.sqlite
SQLITE_BUSY_TIMEOUT_MS=5000

# --- Conversation memory ---
MEMORY_WINDOW_MESSAGES=12
THREAD_TITLE_MAX_LEN=60

# --- LangSmith tracing (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=DrugGPT-chatbot
