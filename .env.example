# --- LLM Configuration ---
LLM_MODEL=openai/gpt-oss-120b

# --- API Keys ---
GROQ_API_KEY=your_groq_api_key
GOOGLE_API_KEY=your_google_api_key

# --- Embedding Configuration ---
EMBEDDING_MODEL_NAME=gemini-embedding-001

# --- Pinecone Configuration ---
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=medicalchatbot
PINECONE_INDEX_HOST=your_pinecone_index_host
PINECONE_NAMESPACE=medical-books

# --- LangSmith Tracing ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=DrugGPT-chatbot

# --- Medical Vector Database ---
RETRIEVAL_MODE=hybrid
MEDICAL_SCOPE_GUARD=true
MEDICAL_BOOKS_DIR=path/to/Medical Books

# --- Document Processing ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# --- Retrieval & Reranking ---
RETRIEVAL_RERANK=true
RERANK_MODEL=bge-reranker-v2-m3

# Supabase Configuration
SUPABASE_URL=https://wapgornrqecotqnrtcxn.supabase.co
# Publishable key: used for sign-in/sign-up and token checks.
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Secret key: server-only. Used to auto-confirm signups and bootstrap the admin.
SUPABASE_SECRET_KEY=your_new_secret_key

# --- Authentication ---
# Set to false only for local development without Supabase.
AUTH_REQUIRED=true
# Optional first-run admin. Created/confirmed on startup when the secret key is
# set, and existing ownerless chats are assigned to this account.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# PostgreSQL (reserved for a future move away from SQLite; unused today)
DATABASE_URL=your_supabase_postgresql_connection_string