# --- LLM (Groq) ---
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
GROQ_API_KEY=your_groq_api_key

# Optional: a cheaper/faster model for the one-word medical scope check.
# Leave empty to reuse LLM_MODEL.
SCOPE_MODEL=
MEDICAL_SCOPE_GUARD=true

# --- Vector database (Pinecone document index) ---
# Pinecone embeds chunk_text with NVIDIA llama-text-embed-v2 (1024 dim, cosine).
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=medicalchatbot
PINECONE_INDEX_HOST=medicalchatbot-p5shb1b.svc.aped-4627-b74a.pinecone.io
PINECONE_NAMESPACE=medical-books

# --- Retrieval ---
# hybrid = semantic + keyword (recommended); dense = semantic only.
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=5
RETRIEVAL_FETCH_K=20
RETRIEVAL_RRF_K=60
# Cross-encoder reranking improves precision after hybrid fusion.
RETRIEVAL_RERANK=true
RERANK_MODEL=bge-reranker-v2-m3

# --- Document ingestion ---
MEDICAL_BOOKS_DIR=Medical Books
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
MIN_CHUNK_CHARS=80
UPSERT_BATCH_SIZE=90

# --- Persistence (SQLite) ---
DATA_DIR=data
SQLITE_CHECKPOINT_DB=data/checkpoints.sqlite
SQLITE_APP_DB=data/app.sqlite
SQLITE_BUSY_TIMEOUT_MS=5000

# --- Conversation memory ---
MEMORY_WINDOW_MESSAGES=12
THREAD_TITLE_MAX_LEN=60

# --- LangSmith tracing (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=DrugGPT-chatbot
