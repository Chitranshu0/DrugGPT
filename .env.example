# --- LLM (Groq) ---
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
GROQ_API_KEY=your_groq_api_key
GOOGLE_API_KEY=your_google_api_key

# --- Vector database (Pinecone) ---
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=medical-rag
EMBEDDING_MODEL_NAME=gemini-embedding-001

# --- Document ingestion ---
MEDICAL_BOOKS_DIR=Medical Books
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Persistence (SQLite) ---
DATA_DIR=data
SQLITE_CHECKPOINT_DB=data/checkpoints.sqlite
SQLITE_APP_DB=data/app.sqlite
SQLITE_BUSY_TIMEOUT_MS=5000

# --- Conversation memory ---
MEMORY_WINDOW_MESSAGES=12
THREAD_TITLE_MAX_LEN=60

# --- LangSmith tracing ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=DrugGPT-chatbot
